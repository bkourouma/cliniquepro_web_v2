# Adresse publique du site et de l'application (liens « Connexion », sitemap, données structurées)
NEXT_PUBLIC_SITE_URL=https://cliniquepro-web.allianceconsultants.net
NEXT_PUBLIC_APP_URL=https://cliniquepro.allianceconsultants.net/demo-login

# Lien public de réservation Cal.com ou Calendly affiché dans la fenêtre « Demander une démonstration ».
# Laissez vide pour utiliser le formulaire de qualification intégré.
NEXT_PUBLIC_BOOKING_URL=https://calendly.com/immotopia/demo-cliniquepro

# Webhook (n8n, Zapier, Make…) qui reçoit les demandes du formulaire intégré. Lu côté serveur uniquement.
N8N_WEBHOOK_URL=

# Codes de vérification de propriété (Google Search Console, Bing Webmaster Tools). Optionnels : sans valeur, aucune balise n'est posée.
# Lus au build : à passer en --build-arg / variable de build du Dockerfile.
# Facultatif : le code de la propriété actuelle est déjà dans src/app/layout.tsx
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
